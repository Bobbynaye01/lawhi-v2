{
  "name": "@lawhi/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, schémas Zod et logique pure partagés (API, mobile, admin)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lawhi/config": "workspace:*",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
