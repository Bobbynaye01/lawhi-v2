# ── Required ────────────────────────────────────────────────────────────────
# Local: docker compose (port 5433). Production: Supabase → Project Settings → Database
# → Connection string (use the "Session pooler" URI on port 5432 for migrations).
DATABASE_URL="postgresql://lawhi:change-me@localhost:5433/lawhi?schema=public"

# ── Supabase (required in production) ──────────────────────────────────────
# Project URL — access tokens are verified against its public JWKS.
SUPABASE_URL=
# SERVER ONLY. Never put this key in the mobile app or the admin web app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROOFS_BUCKET=donation-proofs

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Browser origins allowed by CORS (admin web app, Expo web), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Development only: store donation proofs on disk instead of Supabase Storage.
LOCAL_STORAGE_DIR=./uploads
NOMINATIM_USER_AGENT="Lawhi/1.0 (contact: your-email@example.com)"
