{
  "name": "lawhi",
  "private": true,
  "description": "Lawhi / لوحي — application islamique (Mauritanie)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:api": "pnpm --filter @lawhi/api dev",
    "dev:admin": "pnpm --filter @lawhi/admin dev",
    "dev:mobile": "pnpm --filter @lawhi/mobile start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "6.0.3"
  }
}
