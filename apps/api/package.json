{
  "name": "@lawhi/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST Lawhi (NestJS + Prisma + PostgreSQL/Supabase)",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "prisma generate && nest build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config test/jest-e2e.config.js --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:grant": "node --env-file=.env dist/scripts/grant-admin.js",
    "test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@lawhi/content": "workspace:*",
    "@lawhi/quran-data": "workspace:*",
    "@lawhi/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.117.2",
    "adhan": "^4.4.6",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lawhi/config": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3"
  }
}
